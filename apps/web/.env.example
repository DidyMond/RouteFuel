# Copia in apps/web/.env (ignorato da git). Vite legge questo file solo all'avvio: riavvia `pnpm dev:web`.

# Token Mapbox PUBBLICO per la mappa (Map GL JS), con restrizione per URL: http://localhost:5173/ e il dominio di produzione.
# Non usare qui il token del server. Senza token la schermata Risultati mostra solo l'elenco.
VITE_MAPBOX_PUBLIC_TOKEN=

# Opzionale: se assente il frontend usa http://localhost:3001.
# VITE_API_BASE_URL=http://localhost:3001
