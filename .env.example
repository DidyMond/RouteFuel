# Copia questo file in .env (root) e in apps/api/.env, personalizzando i valori.
# Nessun segreto reale deve mai essere committato: questo file contiene solo placeholder.

# --- Database (apps/api) ---
DATABASE_URL=postgresql://routefuel:routefuel@localhost:5433/routefuel

# --- API server (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Ingestione MIMIT Osservaprezzi (apps/api) ---
# Valori di default già corretti: sovrascrivere solo per puntare a fixture/mirror diversi.
MIMIT_ANAGRAFICA_URL=https://www.mimit.gov.it/images/exportCSV/anagrafica_impianti_attivi.csv
MIMIT_PREZZI_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv

# --- Mapbox (usati dalla Milestone 1 in poi, vedi docs/STACK_DECISION.md §4b — non usati in M0) ---
# Token pubblico con URL-restriction sul dominio di produzione: Map GL JS + Geocoding lato browser.
VITE_MAPBOX_PUBLIC_TOKEN=
# Token pubblico SENZA restrizione URL, usato SOLO lato server per Directions. Mai esposto al browser.
MAPBOX_SERVER_TOKEN=
# Token permissivo separato per sviluppo locale (permette localhost).
VITE_MAPBOX_DEV_TOKEN=

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:3001
