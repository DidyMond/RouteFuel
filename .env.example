# Copia questo file in apps/api/.env e personalizza i valori.
# Nessun segreto reale deve mai essere committato: questo file contiene solo segnaposto.

# --- Database (apps/api) ---
# 5433 e non 5432: evita la collisione con un eventuale PostgreSQL nativo già installato.
DATABASE_URL=postgresql://routefuel:routefuel@localhost:5433/routefuel

# --- API server (apps/api) ---
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# true solo dietro un reverse proxy (Railway, ecc.): altrimenti il rate limit vede sempre l'IP del proxy.
TRUST_PROXY=false

# --- Ingestione MIMIT Osservaprezzi (apps/api) ---
# Valori di default già corretti: sovrascrivere solo per puntare a fixture/mirror diversi.
MIMIT_ANAGRAFICA_URL=https://www.mimit.gov.it/images/exportCSV/anagrafica_impianti_attivi.csv
MIMIT_PREZZI_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv

# --- Mapbox, lato server (Milestone 1) ---
# UN SOLO token, usato SOLO dal backend per Directions e Geocoding. Non va mai nel browser né in git.
# Crea un token dedicato (es. "routefuel-server") sul tuo account Mapbox, senza restrizioni URL.
# Se lasciato vuoto l'API parte comunque, con geocoding "fixture" e routing "mock" (nessuna chiave necessaria).
MAPBOX_SERVER_TOKEN=
# Opzionali: forzano un provider anche in presenza del token. Valori: GEOCODING_PROVIDER=mapbox|fixture, ROUTING_PROVIDER=mapbox|mock
# GEOCODING_PROVIDER=
# ROUTING_PROVIDER=

# --- Prezzi in tempo reale (apps/api) ---
# Il file CSV MIMIT è indietro di 1-2 giorni: prima di ogni ricerca si aggiornano i riquadri del percorso
# dal sito ufficiale Osservaprezzi. Non è un'API pubblica documentata: vedi docs/OPEN_QUESTIONS.md (punto 7).
# 'off' = solo file giornaliero.
# LIVE_PRICES_PROVIDER=ospz
# LIVE_PRICES_BASE_URL=https://carburanti.mise.gov.it/ospzApi
# Identifica RouteFuel verso il ministero: aggiungi un tuo contatto.
# LIVE_PRICES_USER_AGENT=RouteFuel/0.1 (+https://github.com/DidyMond/RouteFuel)
# Un riquadro aggiornato da meno di N minuti non viene richiesto di nuovo.
# LIVE_PRICES_TTL_MIN=60
# Tetto di chiamate al ministero per singola ricerca, attesa massima e chiamate simultanee (max 8).
# Il ministero risponde 429 se si esagera: non alzare senza motivo.
# LIVE_PRICES_MAX_TILES_PER_SEARCH=40
# LIVE_PRICES_DEADLINE_MS=10000
# LIVE_PRICES_CONCURRENCY=3

# --- Limiti a protezione della spesa Mapbox (apps/api) ---
# Kill switch sul contatore mensile delle chiamate Directions (free tier Mapbox: 100.000/mese, nessun tetto di spesa nativo).
# Oltre la soglia soft: niente verifica col routing reale, solo stima geometrica. Oltre la hard: la ricerca risponde 503.
DIRECTIONS_SOFT_LIMIT=80000
DIRECTIONS_HARD_LIMIT=98000
# Richieste al minuto per IP.
SEARCH_RATE_LIMIT_PER_MIN=20
GEOCODE_RATE_LIMIT_PER_MIN=120

# --- Frontend (apps/web) ---
# Opzionale: se assente il frontend usa http://localhost:3001.
# VITE_API_BASE_URL=http://localhost:3001
# Milestone 2 (mappa nel browser): token Mapbox SEPARATO da quello del server, con restrizione per URL.
# VITE_MAPBOX_PUBLIC_TOKEN=
