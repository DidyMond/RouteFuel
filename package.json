{
  "name": "routefuel",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @routefuel/web dev",
    "dev:api": "pnpm --filter @routefuel/api dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @routefuel/api migrate",
    "ingest": "pnpm --filter @routefuel/api ingest"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
